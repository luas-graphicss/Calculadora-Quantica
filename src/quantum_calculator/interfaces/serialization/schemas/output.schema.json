{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantum-calculator:schema:output:1.2",
  "title": "Documentos de saída da Calculadora Quântica",
  "oneOf": [
    {
      "$ref": "#/$defs/validation"
    },
    {
      "$ref": "#/$defs/run_record"
    },
    {
      "$ref": "#/$defs/statement_validation"
    },
    {
      "$ref": "#/$defs/statement_run_record"
    },
    {
      "$ref": "#/$defs/numerical_validation"
    },
    {
      "$ref": "#/$defs/numerical_run_record"
    },
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/rejection"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d+)?(E[+-]\\d+)?$"
    },
    "exact_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decimal",
        "is_exact",
        "numerator",
        "denominator",
        "unit"
      ],
      "properties": {
        "decimal": {
          "$ref": "#/$defs/decimal"
        },
        "is_exact": {
          "type": "boolean"
        },
        "numerator": {
          "type": "string",
          "pattern": "^-?\\d+$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9]\\d*$"
        },
        "unit": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "schema_version",
        "description",
        "text"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "const": "1.0"
        },
        "description": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "symbol",
            "origin",
            "given",
            "si"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "symbol": {
              "$ref": "#/$defs/text"
            },
            "origin": {
              "const": "user"
            },
            "given": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "unit"
              ],
              "properties": {
                "value": {
                  "$ref": "#/$defs/text"
                },
                "unit": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "si": {
              "$ref": "#/$defs/exact_value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "symbol",
            "origin",
            "constant",
            "si"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "symbol": {
              "$ref": "#/$defs/text"
            },
            "origin": {
              "const": "catalog_constant"
            },
            "constant": {
              "$ref": "#/$defs/text"
            },
            "si": {
              "$ref": "#/$defs/exact_value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "symbol",
            "origin",
            "count"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "symbol": {
              "$ref": "#/$defs/text"
            },
            "origin": {
              "const": "user"
            },
            "count": {
              "type": "string",
              "pattern": "^[1-9]\\d*$"
            }
          }
        }
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card",
        "scope",
        "hypotheses",
        "parameters",
        "requested",
        "uncertainty"
      ],
      "properties": {
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifier",
            "version",
            "area",
            "title"
          ],
          "properties": {
            "identifier": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "$ref": "#/$defs/text"
            },
            "area": {
              "$ref": "#/$defs/text"
            },
            "title": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value",
              "statement"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "statement": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "requested": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "symbol",
            "label",
            "unit",
            "significant_digits"
          ],
          "properties": {
            "quantity": {
              "$ref": "#/$defs/text"
            },
            "symbol": {
              "$ref": "#/$defs/text"
            },
            "label": {
              "$ref": "#/$defs/text"
            },
            "unit": {
              "$ref": "#/$defs/text"
            },
            "significant_digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 34
            }
          }
        },
        "uncertainty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "covariance",
                "standard_uncertainties"
              ],
              "properties": {
                "covariance": {
                  "$ref": "#/$defs/text"
                },
                "standard_uncertainties": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "parameter",
                      "given",
                      "si"
                    ],
                    "properties": {
                      "parameter": {
                        "$ref": "#/$defs/text"
                      },
                      "given": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "value",
                          "unit"
                        ],
                        "properties": {
                          "value": {
                            "$ref": "#/$defs/text"
                          },
                          "unit": {
                            "$ref": "#/$defs/text"
                          }
                        }
                      },
                      "si": {
                        "$ref": "#/$defs/exact_value"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "nature",
        "justification",
        "rounding"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/text"
        },
        "nature": {
          "enum": [
            "exact",
            "approximate"
          ]
        },
        "justification": {
          "$ref": "#/$defs/text"
        },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "significant_digits"
          ],
          "properties": {
            "mode": {
              "const": "half_even"
            },
            "significant_digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 34
            }
          }
        }
      }
    },
    "constant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "symbol",
        "name",
        "value",
        "exactness",
        "standard_uncertainty",
        "source"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/text"
        },
        "symbol": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "$ref": "#/$defs/exact_value"
        },
        "exactness": {
          "enum": [
            "exact",
            "measured"
          ]
        },
        "standard_uncertainty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/exact_value"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "uncertainty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not_evaluated"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "covariance",
            "standard_uncertainty",
            "relative_standard_uncertainty",
            "significant_digits",
            "variance",
            "contributions"
          ],
          "properties": {
            "status": {
              "const": "evaluated"
            },
            "method": {
              "const": "linear_propagation"
            },
            "covariance": {
              "$ref": "#/$defs/text"
            },
            "standard_uncertainty": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decimal",
                "unit"
              ],
              "properties": {
                "decimal": {
                  "$ref": "#/$defs/decimal"
                },
                "unit": {
                  "$ref": "#/$defs/text"
                }
              }
            },
            "relative_standard_uncertainty": {
              "$ref": "#/$defs/decimal"
            },
            "significant_digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 34
            },
            "variance": {
              "$ref": "#/$defs/exact_value"
            },
            "contributions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "parameter",
                  "symbol",
                  "sensitivity",
                  "standard_uncertainty",
                  "variance"
                ],
                "properties": {
                  "parameter": {
                    "$ref": "#/$defs/text"
                  },
                  "symbol": {
                    "$ref": "#/$defs/text"
                  },
                  "sensitivity": {
                    "$ref": "#/$defs/exact_value"
                  },
                  "standard_uncertainty": {
                    "$ref": "#/$defs/exact_value"
                  },
                  "variance": {
                    "$ref": "#/$defs/exact_value"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "symbol",
        "nature",
        "expression",
        "value",
        "si_value",
        "conversion",
        "steps",
        "uncertainty"
      ],
      "properties": {
        "quantity": {
          "$ref": "#/$defs/text"
        },
        "symbol": {
          "$ref": "#/$defs/text"
        },
        "nature": {
          "enum": [
            "exact",
            "approximate"
          ]
        },
        "expression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plain",
            "latex"
          ],
          "properties": {
            "plain": {
              "$ref": "#/$defs/text"
            },
            "latex": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "value": {
          "$ref": "#/$defs/exact_value"
        },
        "si_value": {
          "$ref": "#/$defs/exact_value"
        },
        "conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "si_factor",
            "defining_constants"
          ],
          "properties": {
            "unit": {
              "$ref": "#/$defs/text"
            },
            "si_factor": {
              "$ref": "#/$defs/exact_value"
            },
            "defining_constants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "expression",
              "value"
            ],
            "properties": {
              "description": {
                "$ref": "#/$defs/text"
              },
              "expression": {
                "$ref": "#/$defs/text"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/exact_value"
                  }
                ]
              }
            }
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "not_performed",
        "references"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "conditional",
            "inconclusive",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "kind",
              "status",
              "statement",
              "observed"
            ],
            "properties": {
              "identifier": {
                "$ref": "#/$defs/text"
              },
              "kind": {
                "enum": [
                  "proof",
                  "numerical_evidence",
                  "consistency_test"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "conditional",
                  "inconclusive",
                  "failed"
                ]
              },
              "statement": {
                "$ref": "#/$defs/text"
              },
              "observed": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "not_performed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "reason"
            ],
            "properties": {
              "identifier": {
                "$ref": "#/$defs/text"
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "python",
        "platform",
        "dependencies",
        "linear_algebra"
      ],
      "properties": {
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version"
          ],
          "properties": {
            "implementation": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "platform": {
          "$ref": "#/$defs/text"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "version": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "linear_algebra": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "consumer",
              "interface",
              "name",
              "version"
            ],
            "properties": {
              "consumer": {
                "$ref": "#/$defs/text"
              },
              "interface": {
                "enum": [
                  "blas",
                  "lapack"
                ]
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "version": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "notated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "latex",
        "structure"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "latex": {
          "$ref": "#/$defs/text"
        },
        "structure": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "read_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "text",
        "latex",
        "structure"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "latex": {
          "$ref": "#/$defs/text"
        },
        "structure": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "domain_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "scope",
        "expression",
        "text"
      ],
      "properties": {
        "relation": {
          "enum": [
            "nonzero",
            "positive",
            "nonnegative"
          ]
        },
        "scope": {
          "enum": [
            "pointwise",
            "integration_interval"
          ]
        },
        "expression": {
          "$ref": "#/$defs/notated"
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "statement_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "domain",
        "unit",
        "argument"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "enum": [
            "variable",
            "parameter",
            "function"
          ]
        },
        "domain": {
          "enum": [
            "real",
            "positive",
            "negative",
            "nonnegative",
            "nonzero"
          ]
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "argument": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        }
      }
    },
    "statement_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card",
        "domain",
        "notation",
        "statement",
        "symbols",
        "conditions",
        "candidate",
        "result_unit"
      ],
      "properties": {
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifier",
            "version",
            "area",
            "problem_type",
            "title",
            "selection"
          ],
          "properties": {
            "identifier": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "area": {
              "$ref": "#/$defs/text"
            },
            "problem_type": {
              "$ref": "#/$defs/text"
            },
            "title": {
              "$ref": "#/$defs/text"
            },
            "selection": {
              "enum": [
                "confirmed",
                "suggested"
              ]
            }
          }
        },
        "domain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "notation": {
          "enum": [
            "text",
            "latex"
          ]
        },
        "statement": {
          "$ref": "#/$defs/read_statement"
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement_symbol"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/read_statement"
          }
        },
        "candidate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/read_statement"
            }
          ]
        },
        "result_unit": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "statement_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "nature",
        "justification",
        "budget"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/text"
        },
        "nature": {
          "enum": [
            "exact",
            "approximate"
          ]
        },
        "justification": {
          "$ref": "#/$defs/text"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_seconds",
            "cpu_seconds",
            "memory_bytes"
          ],
          "properties": {
            "wall_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpu_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "statement_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nature",
        "answer",
        "unit",
        "validity",
        "assumptions",
        "special_cases",
        "arbitrary_constants",
        "certificate",
        "steps"
      ],
      "properties": {
        "nature": {
          "enum": [
            "exact",
            "approximate"
          ]
        },
        "answer": {
          "$ref": "#/$defs/notated"
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "validity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain_condition"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domain_condition"
